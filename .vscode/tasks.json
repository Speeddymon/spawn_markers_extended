{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start RuneLite for VS Code debugger",
      "type": "shell",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [
        "debugSpawnMarkers",
        "--console=plain"
      ],
      "options": {
        "env": {
          "JAVA_HOME": "${config:java.import.gradle.java.home}"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(Listening for transport dt_socket at address: .*5005)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> Task :debugSpawnMarkers$",
          "endsPattern": "^Listening for transport dt_socket at address: .*5005$"
        }
      }
    }
  ]
}
